{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:invrnt/tv-themes:minimal",
  "title": "Minimal",
  "description": "Pure black, four large cards with no dock band, soft shadows and a quiet header without the greeting.",
  "author": {
    "name": "invrnt",
    "url": "https://github.com/invrnt"
  },
  "themeVersion": "1.0.1",
  "layout": {
    "preset": "dock-grid",
    "columns": 4,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1
