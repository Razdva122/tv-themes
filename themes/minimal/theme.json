  "defaults": {
    "wallpaperAssetId": null,
    "dim": 0,
    "accent": "#ffffff"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "preview-inputs",
      "path": "assets/preview-inputs.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
